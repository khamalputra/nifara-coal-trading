# ==============================================================================
# PT. Nifara Coal Trading - Environment Configuration Template
# Salin file ini menjadi .env pada server hosting Anda jika diperlukan.
# JANGAN PERNAH mengunggah file .env asli Anda ke repositori publik.
# ==============================================================================

# Database Connection (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_secure_database_password

# Initial Administrator Seed (Opsional - Jika ingin di-seed via ENV)
ADMIN_USER=admin
ADMIN_PASS=your_strong_admin_password
