# ==========================================================
# PT. NIFARA COAL TRADING
# Server Configuration (.htaccess)
# Optimized for cPanel Rumahweb (LiteSpeed & Apache)
# ==========================================================

# 1. Enable Rewrite Engine & Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical 301 Redirects: Remove index.php from URL
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php [NC]
  RewriteRule ^index\.php$ https://%{HTTP_HOST}/ [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /berita/index\.php [NC]
  RewriteRule ^berita/index\.php$ https://%{HTTP_HOST}/berita/ [R=301,L]

  # Redirect legacy /berita/detail.php?slug=xxx to clean /berita/xxx
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /berita/detail\.php\?slug=([a-zA-Z0-9_-]+) [NC]
  RewriteRule ^berita/detail\.php$ https://%{HTTP_HOST}/berita/%1? [R=301,L]

  # Pretty URL for articles: /berita/judul-slug -> /berita/detail.php?slug=judul-slug
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^berita/([a-zA-Z0-9_-]+)/?$ berita/detail.php?slug=$1 [L,QSA]

  # Redirect 404 to custom error page
  ErrorDocument 404 /404.php
</IfModule>

# 2. Prevent Directory Browsing & Block Direct Access to Sensitive Files
Options -Indexes

<FilesMatch "(\.(sql|sqlite|db|log|env|ini|sh|bak|swp|md|git)|database\.sqlite)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# 3. Security Headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-src 'self' https://www.google.com https://maps.google.com;"
</IfModule>

# 4. LiteSpeed & Browser Caching Optimization
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Icons
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 5. Gzip & Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml font/woff font/woff2 image/svg+xml
</IfModule>

# 6. Static Asset Cache-Control Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2|pdf)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
